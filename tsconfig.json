{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2020",
    "types": ["node"],
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "preserve",
    "outDir": "./dist",
    "paths": {
      "@shared/*": ["../../shared/*"],
      "@assets/*": ["./assets/*"],
      "@/*": ["./src/*"],
      "@main/*": ["./src/MainGenerator/*"],
      "@config/*": ["./src/ConfigMaker/*"],
      "@game/*": ["./src/GameScripts/*"],
      "@sounds/*": ["./src/common/sounds/*"],
      "@migrations/*": ["./src/common/migrations/*"]
    }
  },
  "include": [
    "../../shared/**/*.ts",
    "../../shared/**/*.d.ts",
    "../../shared/**/*.vue",
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.vue",
    "server/**/*.ts",
    "tools/**/*.ts"
  ],
  "exclude": ["node_modules", "archives", "**/*.test.ts"]
}
