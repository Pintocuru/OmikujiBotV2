{
 "extends": "../../tsconfig.base.json",
 "compilerOptions": {
  "baseUrl": ".",
  "typeRoots": [
   "./src/types/*"
  ],
  "outDir": "./dist",
  "paths": {
   "@shared/*": [
    "../../shared/*"
   ],
   "@assets/*": [
    "./assets/*"
   ],
   "@/*": [
    "./src/*"
   ],
   "@LogRank/*": [
    "src/GameScripts/LogRank/src/*"
   ],
   "@Config/*": [
    "./src/ConfigMaker/*"
   ],
   "@ConfigComponents/*": [
    "./src/ConfigMaker/components/*"
   ],
   "@ConfigScript/*": [
    "./src/ConfigMaker/script/*"
   ],
   "@ConfigStore/*": [
    "./src/ConfigMaker/store/*"
   ]
  }
 },
 "include": [
  "src/**/*.ts",
  "src/**/*.d.ts",
  "src/**/*.vue"
 ],
 "exclude": [
  "node_modules",
  "**/*.spec.ts",
  "**/*.test.ts"
 ]
}