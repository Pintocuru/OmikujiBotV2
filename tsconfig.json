{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2020",
    "types": ["node"],
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "preserve",
    "outDir": "./dist",
    "paths": {
      "@onecomme.com/onesdk": ["./src/types/onesdk-shim.ts"],
      "@shared/*": ["../../shared/*"],
      "@assets/*": ["./assets/*"],
      "@/*": ["./src/*"],
      "@LogRank/*": ["./src/GameScripts/LogRank/src/*"],
      "@ConfigComponents/*": ["./src/ConfigMaker/components/*"],
      "@ConfigScript/*": ["./src/ConfigMaker/scripts/*"],
      "@ConfigStores/*": ["./src/ConfigMaker/stores/*"],
      "@MainComponents/*": ["./src/MainGenerator/components/*"],
      "@MainScripts/*": ["./src/MainGenerator/scripts/*"]
    }
  },
  "include": [
    "../../shared/**/*.ts",
    "../../shared/**/*.d.ts",
    "../../shared/**/*.vue",
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.vue",
    "server/**/*.ts",
    "tools/**/*.ts"
  ],
  "exclude": ["node_modules", "archives", "**/*.test.ts"]
}
