{
 "extends": "../../tsconfig.json", // 親の設定をマージ
 "compilerOptions": {
  "baseUrl": ".", // モジュールのベースURL
  "typeRoots": [
   "./src/types/*",
  ],
  "outDir": "./dist", // 出力先ディレクトリ
  "paths": {
   "@shared/*": [
    "../../shared/*"
   ],
   "@assets/*": [
    "./assets/*"
   ],
   "@/*": [
    "./src/*"
   ],
   "@LogRank/*": [
    "src/GameScripts/LogRank/src/*"
   ],
   "@Config/*": [
    "./src/ConfigMaker/*"
   ],
   "@ConfigComponents/*": [
    "./src/ConfigMaker/components/*"
   ],
   "@ConfigScript/*": [
    "./src/ConfigMaker/script/*"
   ],
   "@ConfigStore/*": [
    "./src/ConfigMaker/store/*"
   ],
  }
 },
 // コンパイル対象ファイル
 "include": [
  "src/**/*.ts",
  "src/**/*.d.ts",
  "src/**/*.vue",
 ],
 "exclude": [
  "node_modules",
  "**/*.spec.ts", // 例: .spec.ts で終わるファイルをすべて除外
  "**/*.test.ts" // test.ts ファイルのみを除外
 ]
}