// tsconfig.jest.json
{
 "compilerOptions": {
  "module": "ESNext",
  "target": "ES2020",
  "moduleResolution": "node",
  "types": [
   "jest",
   "node"
  ],
  "baseUrl": ".", // エイリアスのために必要
  "paths": {
   "@shared/*": [
    "../../../../shared/*"
   ],
   "@assets/*": [
    "../../assets/*"
   ],
   "@/*": [
    "../../src/*"
   ],
   "@LogRank/*": [
    "../../src/GameScripts/LogRank/src/*"
   ],
   "@Config/*": [
    "../../src/ConfigMaker/*"
   ],
   "@ConfigComponents/*": [
    "../../src/ConfigMaker/components/*"
   ],
   "@ConfigScript/*": [
    "../../src/ConfigMaker/script/*"
   ],
   "@ConfigStore/*": [
    "../../src/ConfigMaker/store/*"
   ]
  }
 },
 "include": [
  "src/**/*.ts",
  "tests/**/*.ts" // testsを含める
 ],
 "exclude": [
  "node_modules"
 ]
}