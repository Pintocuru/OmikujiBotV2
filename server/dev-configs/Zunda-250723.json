 "placeholders": {
  "zundaOmikuji01": {
   "id": "zundaOmikuji01",
   "name": "ずんだもんのおみくじ:大吉",
   "order": 7,
   "editorColor": "#10B981",
   "values": [
    {
     "weight": 1,
     "content": "人との縁がすごく良さそうなのだ!感謝の気持ちを忘れずにいるといいのだ。"
    },
    {
     "weight": 1,
     "content": "健康運がバッチリなのだ!元気いっぱいで過ごせそうなのだ。"
    },
    {
     "weight": 1,
     "content": "頑張ってきたことが報われそうなのだ!積極的に行動するといいことがあるのだ。"
    },
    {
     "weight": 1,
     "content": "新しいことに挑戦すると、うまくいきそうなのだ!勇気を出して頑張るのだ。"
    },
    {
     "weight": 1,
     "content": "良いお知らせが来そうなのだ!前向きな気持ちでいるといいのだ。"
    },
    {
     "weight": 1,
     "content": "難しいことも乗り越えられそうなのだ!自信を持って進むといいのだ。"
    }
   ]
  },
  "zundaOmikuji02": {
   "id": "zundaOmikuji02",
   "name": "ずんだもんのおみくじ:吉",
   "order": 8,
   "editorColor": "#10B981",
   "values": [
    {
     "weight": 1,
     "content": "積極的に行動すると運気が上がりそうなのだ!新しいことにチャレンジするといいのだ。"
    },
    {
     "weight": 1,
     "content": "周りの人に感謝する気持ちを忘れないでいるのだ。"
    },
    {
     "weight": 1,
     "content": "これからの未来は明るそうなのだ!夢に向かって頑張るといいことがあるのだ。"
    },
    {
     "weight": 1,
     "content": "みんなで協力すると成功しやすそうなのだ!仲間を大切にするのだ。"
    },
    {
     "weight": 1,
     "content": "小さな努力が大きな成果になりそうなのだ!コツコツ続けることが大事なのだ。"
    },
    {
     "weight": 1,
     "content": "前向きに考えると良い結果になりそうなのだ!ポジティブでいるのだ。"
    }
   ]
  },
  "zundaOmikuji03": {
   "id": "zundaOmikuji03",
   "name": "ずんだもんのおみくじ:中吉",
   "order": 9,
   "editorColor": "#10B981",
   "values": [
    {
     "weight": 1,
     "content": "思わぬ幸運があるかもしれないのだ!チャンスを見逃さないようにするのだ。"
    },
    {
     "weight": 1,
     "content": "周りの人と協力すると良いことがありそうなのだ!助けを求めるのも大事なのだ。"
    },
    {
     "weight": 1,
     "content": "自分の気持ちを信じるといいのだ!大きく成長できそうなのだ。"
    },
    {
     "weight": 1,
     "content": "新しいことを学ぶと良さそうなのだ!自分を磨くチャンスなのだ。"
    },
    {
     "weight": 1,
     "content": "楽しいことが増えそうなのだ!笑顔を忘れずにいるのだ。"
    },
    {
     "weight": 1,
     "content": "しっかり計画を立てると、うまくいきそうなのだ!"
    }
   ]
  },
  "zundaOmikuji04": {
   "id": "zundaOmikuji04",
   "name": "ずんだもんのおみくじ:小吉",
   "order": 10,
   "editorColor": "#10B981",
   "values": [
    {
     "weight": 1,
     "content": "焦らずに一歩ずつ進むといいのだ!頑張れば願いは叶いそうなのだ。"
    },
    {
     "weight": 1,
     "content": "慎重に行動すると良さそうなのだ!きっと良いことがあるのだ。慌てないのが大切なのだ。"
    },
    {
     "weight": 1,
     "content": "健康に気をつけるといいのだ!規則正しい生活をすると運気が上がりそうなのだ。"
    },
    {
     "weight": 1,
     "content": "周りの人の助けを受け入れると、運気が上がりそうなのだ!"
    },
    {
     "weight": 1,
     "content": "小さな喜びを大切にするのだ!それが大きな幸せになるかもしれないのだ。"
    },
    {
     "weight": 1,
     "content": "ゆっくりと良くなっていきそうなのだ!焦らずに自分のペースで進むといいのだ。"
    }
   ]
  },
  "zundaOmikuji05": {
   "id": "zundaOmikuji05",
   "name": "ずんだもんのおみくじ:末吉",
   "order": 11,
   "editorColor": "#10B981",
   "values": [
    {
     "weight": 1,
     "content": "油断しないように気をつけるのだ!慎重に行動するといいのだ。"
    },
    {
     "weight": 1,
     "content": "今は少し大変かもしれないのだ。でも、乗り越えると大きく成長できそうなのだ。"
    },
    {
     "weight": 1,
     "content": "新しいことより、今やっていることを見直すと良いことがありそうなのだ。"
    },
    {
     "weight": 1,
     "content": "計画を立て直すと、もっと良くなりそうなのだ!"
    },
    {
     "weight": 1,
     "content": "周りの人の意見を聞くと、うまくいきそうなのだ!"
    },
    {
     "weight": 1,
     "content": "自分を良くしようと努力すると、運が開けそうなのだ!自分のことをよく考えてみるのだ。"
    }
   ]
  },
  "zundaOmikuji06": {
   "id": "zundaOmikuji06",
   "name": "ずんだもんのおみくじ:凶",
   "order": 12,
   "editorColor": "#10B981",
   "values": [
    {
     "weight": 1,
     "content": "運気が少し下がっているかもしれないのだ。でも、慎重に行動すれば大丈夫なのだ!"
    },
    {
     "weight": 1,
     "content": "周りの人とケンカしないように気をつけるのだ!もし喧嘩になっても、落ち着いて考えるのだ。"
    },
    {
     "weight": 1,
     "content": "健康に気をつけるといいのだ!体調管理をしっかりするのだ。ずんだもち1個贈呈なのだ。"
    },
    {
     "weight": 1,
     "content": "計画通りにいかないかもしれないのだ。でも、焦らずに柔軟に対応するといいのだ!"
    },
    {
     "weight": 1,
     "content": "信頼できる人に相談すると、助けてくれるかもしれないのだ!"
    },
    {
     "weight": 1,
     "content": "無理をしないで、休むことも大切なのだ!リラックスする時間を作るといいのだ。"
    }
   ]
  },
  "zundaOmikuji07": {
   "id": "zundaOmikuji07",
   "name": "ずんだもんのおみくじ:残念賞",
   "order": 13,
   "editorColor": "#10B981",
   "values": [
    {
     "weight": 1,
     "content": "やらかしたのだ、こんな格好で来ちゃったのだ…でもそんなの関係ねぇ!おっぱっぴーなのだ!"
    },
    {
     "weight": 1,
     "content": "安心してくださいなのだ、穿いているのだ…いやいや、ぱんつは穿いてない、水着の下にぱんつは穿かないのだ!"
    },
    {
     "weight": 1,
     "content": "なーにー!やっちまったのだ。男は…女は黙って、鳥羽一郎、GO!ペンギンゲットなのだ!"
    },
    {
     "weight": 1,
     "content": "ドキッ!僕だけ水着…VOICEVOX大会。ポロリ!？ポロリなんて絶対ないのだ、にこにこぷん!"
    },
    {
     "weight": 1,
     "content": "僕にお盆を持たせないで欲しいのだ、何が100%なのだ、100%は評価値だけでいいのだ!"
    },
    {
     "weight": 1,
     "content": "何がドーン!なのだ、水着はそんなに伸びない…チャンネル登録100万人!？それは伸び過ぎなのだ!アタオカ!"
    }
   ]
  }
 },
